# Copier ce fichier vers .env (a la racine) puis adapter. AUCUN secret reel ici.
NODE_ENV=development
PORT=4000
CLIENT_ORIGIN=http://localhost:5173
# Les transactions MongoDB exigent un replica set (voir README).
MONGODB_URI=mongodb://127.0.0.1:27017/k-manage?replicaSet=rs0
# Duree d'une session en heures
SESSION_TTL_HOURS=168
# En dev uniquement : renvoie le jeton de reinitialisation dans la reponse (jamais en production)
DEV_EXPOSE_RESET_TOKEN=false
# Mettre false UNIQUEMENT pour un MongoDB sans replica set en dev/test (jamais en production)
USE_TRANSACTIONS=true
# Dossier des fichiers televerses (images produits, justificatifs)
UPLOAD_DIR=./uploads
# Envoi d'emails (reinitialisation du mot de passe). Laisser vide = aucun email envoye. Ex: smtp://user:pass@smtp.example.com:587
SMTP_URL=
MAIL_FROM=K-Manage <no-reply@example.com>
# true si l'API est derriere un proxy HTTPS (hebergeur)
TRUST_PROXY=false
# Si le frontend et l'API sont sur deux sous-domaines (app.exemple.com / api.exemple.com), mettre le domaine parent : exemple.com
# COOKIE_DOMAIN=
